{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LILYGO-UI/packages/main/publish.schema.json",
  "title": "LILYGO UI App Publish Manifest",
  "description": "Schema for publish files used by LILYGO UI applications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "package",
    "version",
    "app_id",
    "title",
    "summary",
    "description",
    "authors",
    "categories",
    "license",
    "source_repo",
    "homepage",
    "assets",
    "permissions",
    "compatibility",
    "launcher"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://raw.githubusercontent.com/LILYGO-UI/packages/main/publish.schema.json"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "package": {
      "type": "string",
      "description": "Lowercase Debian package name.",
      "pattern": "^lilygo-ui-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "description": "Debian-compatible package version.",
      "pattern": "^(?:[0-9]+:)?[0-9][A-Za-z0-9.+~]*(?:-[A-Za-z0-9.+~]+)?$"
    },
    "app_id": {
      "type": "string",
      "description": "Stable LILYGO UI application identifier.",
      "pattern": "^cc\\.lilygo\\.ui\\.[A-Z][A-Za-z0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Development",
          "Education",
          "Games",
          "Graphics",
          "Lifestyle",
          "Multimedia",
          "Network",
          "Office",
          "Science",
          "System",
          "Utilities"
        ]
      }
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier or expression.",
      "minLength": 1,
      "maxLength": 128
    },
    "source_repo": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Public HTTPS source repository URL."
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "assets": {
      "$ref": "#/$defs/assets"
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "launcher": {
      "$ref": "#/$defs/launcher"
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "github": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        }
      },
      "anyOf": [
        {
          "required": [
            "email"
          ]
        },
        {
          "required": [
            "github"
          ]
        }
      ]
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
      "description": "Repository-relative path without parent-directory traversal."
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "icon",
        "screenshots"
      ],
      "properties": {
        "icon": {
          "allOf": [
            {
              "$ref": "#/$defs/repository_path"
            },
            {
              "pattern": "\\.png$"
            }
          ]
        },
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/screenshot"
          }
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "caption"
      ],
      "properties": {
        "path": {
          "allOf": [
            {
              "$ref": "#/$defs/repository_path"
            },
            {
              "pattern": "\\.(?:png|webp|jpg|jpeg)$"
            }
          ]
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "network",
            "filesystem",
            "background-service",
            "bluetooth",
            "camera",
            "microphone",
            "location",
            "serial",
            "gpio",
            "i2c",
            "spi",
            "imu",
            "external-display"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "access": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "read-write"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "app-data",
            "shared-data",
            "removable-storage"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "filesystem"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "required": [
              "access",
              "scope"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "access"
                  ]
                },
                {
                  "required": [
                    "scope"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architectures",
        "min_appkit_version"
      ],
      "properties": {
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "arm64"
            ]
          }
        },
        "min_appkit_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Launcher sort order; lower values appear first."
        }
      }
    }
  }
}
